<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Button name="EQWorldQuestPinTemplate" mixin="EQWorldQuestPinMixin" hidden="true" virtual="true">
        <Size x="34" y="34"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="icon">
                    <Anchors><Anchor point="CENTER"/></Anchors>
                    <Size x="22" y="22"/>
                </Texture>
                <MaskTexture parentKey="iconMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.icon"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.icon"/>
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="icon"/>
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="ring">
                    <Anchors><Anchor point="CENTER"/></Anchors>
                    <Size x="34" y="34"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="timeText" inherits="GameFontWhiteSmall" text="">
                    <Anchors>
                        <Anchor point="TOP" relativePoint="BOTTOM" x="0" y="-1"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Button>
</Ui>
