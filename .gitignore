# VS Code
.vscode/

# Packager output
*.zip
.release/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Backup files
*.bak
*.orig

# Localization translator worksheets (throwaway; regenerated from the manifest)
frFR-TRANSLATE-ME*.lua
ruRU-TRANSLATE-ME*.lua
koKR-TRANSLATE-ME*.lua

# Local dev tooling + drafts (not part of the shipped addon)
docs/

# Bytecode from the tools/ gates. tools/ is TRACKED, unlike docs/, so without this
# 'git add -A' commits tools/__pycache__ the first time a gate runs.
__pycache__/
*.pyc

# EverythingQuests_Vanilla.toc is tracked as of v1.39.0 and EverythingQuests_TBC.toc as of
# v1.41.0. Both flavors are limited but real and tested in game, and each TOC declares every
# omission rather than claiming coverage. Nothing here is ignored any more - the packager
# derives a CurseForge game version from every TOC it packages, and both claims are ones we
# can stand behind.

# Built by the release workflow from CHANGELOG.md, and by the pre-flight awk locally.
.release_changelog.md
