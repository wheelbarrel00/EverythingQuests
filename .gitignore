# VS Code
.vscode/

# Packager output
*.zip
.release/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Backup files
*.bak
*.orig

# Localization translator worksheets (throwaway; regenerated from the manifest)
frFR-TRANSLATE-ME*.lua
ruRU-TRANSLATE-ME*.lua
koKR-TRANSLATE-ME*.lua

# Local dev tooling + drafts (not part of the shipped addon)
docs/

# Bytecode from the tools/ gates. tools/ is TRACKED, unlike docs/, so without this
# 'git add -A' commits tools/__pycache__ the first time a gate runs.
__pycache__/
*.pyc

# The TBC TOC is still a probe scaffold - it loads Core/Init.lua and Core/FlavorProbe.lua and
# nothing else. The packager derives a CurseForge game version from every TOC it packages, so
# committing this would advertise TBC support for an addon that only runs a probe there.
# DELETE THIS LINE when it lists a real, tested addon and that claim is one we can stand behind.
#
# EverythingQuests_Vanilla.toc is tracked as of v1.39.0. Classic Era support is limited but
# real and tested in game, and the TOC declares every omission rather than claiming coverage.
EverythingQuests_TBC.toc
